, 170px" alt="" loading="lazy" src="https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette.png" srcset="https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette-p-500.png 500w, https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette-p-800.png 800w, https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette-p-1080.png 1080w, https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette-p-1600.png 1600w, https://cdn.prod.website-files.com/6938169ca88035d1476d6905/6a9e74e6d623c9247d117916_tractor%20silhouette.png 1656w" class="our-product-image"/><div class="product-name">Tractor e-45<br/></div></a></div></div></div></div><div class="code-embed-4 w-embed w-script"><script>

document.addEventListener("DOMContentLoaded", function(){

  const openBtn = document.querySelector("[data-product-open]");
  const dialog = document.getElementById("products-dialog");
  const ourProducts = document.getElementById("our-products");
  const menu = document.getElementById("menu-dialog-items");
  const products = document.getElementById("products-dialog-content");
  const closeBtn = document.querySelector("[data-dialog-close]");
  const backToMenu = document.querySelector("[data-back-to-menu]");
  const mobileHamburgerMenu = document.getElementById("mobile-hamburger-menu")

  openBtn?.addEventListener("click", function(e){
    e.preventDefault();
    dialog.style.display = "block";
    console.log(window.innerWidth);
    if(window.innerWidth < 768){
    	menu.style.display = "flex";
    	products.style.display = "none";
    }
    backToMenu.style.display = "none";
    
    document.body.style.overflow = "hidden";
  });
  ourProducts?.addEventListener("click", function(e){
    e.preventDefault();
    dialog.style.display = "block";
    menu.style.display = "none";
    products.style.display = "flex";
    backToMenu.style.display = "block";
    
    document.body.style.overflow = "hidden";
  });
  mobileHamburgerMenu?.addEventListener("click", function(e){
    e.preventDefault();
    dialog.style.display = "block";
    menu.style.display = "flex";
    products.style.display = "none";
    document.body.style.overflow = "hidden";
  });

  closeBtn?.addEventListener("click", function(){
    dialog.style.display = "none";
    if(window.innerWidth < 768){
    	menu.style.display = "flex";
    	products.style.display = "none";
    }
    backToMenu.style.display = "none";
    
    document.body.style.overflow = "auto";
  });
  backToMenu?.addEventListener("click", function(e){
    e.preventDefault();
    dialog.style.display = "block";
    menu.style.display = "flex";
    products.style.display = "none";
    backToMenu.style.display = "none";
    document.body.style.overflow = "hidden";
  });

});

